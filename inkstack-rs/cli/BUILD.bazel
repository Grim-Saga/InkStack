load("@crates//:data.bzl", "DEP_DATA")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "inkstack_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "inkstack_e2e_benchmark")
load("//bazel/rules:runtime_package.bzl", "release_binary")

inkstack_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["inkstack"],
    crate_name = "inkstack_cli",
    extra_binaries = [
        "//inkstack-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

# Real installation copies a full debug package. Run after other Bazel tests
# on the CI runner so remote executors do not amplify shared-disk writeback.
rust_test(
    name = "cli-app_server_daemon_package-test",
    timeout = "long",
    srcs = [
        "tests/app_server_daemon/package.rs",
        "tests/app_server_daemon/support.rs",
    ],
    args = ["--test-threads=1"],
    crate_name = "app_server_daemon_package",
    crate_root = "tests/app_server_daemon/package.rs",
    data = [":inkstack"],
    env = {"CARGO_BIN_EXE_inkstack": "$(rlocationpath :inkstack)"},
    rustc_env = {"BAZEL_PACKAGE": "inkstack-rs/cli"},
    rustc_flags = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    tags = ["exclusive"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    version = DEP_DATA["inkstack-rs/cli"]["version"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

release_binary(
    binary = ":inkstack",
)

multiplatform_binaries(
    name = "inkstack",
)

inkstack_e2e_benchmark(
    name = "inkstack-help",
    binaries = [":inkstack"],
)
