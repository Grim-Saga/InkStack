load("//:defs.bzl", "inkstack_rust_crate")
load("//bazel/rules/testing/compat:exec_server_compat_test.bzl", "exec_server_compat_test")

exports_files(
    ["src/proto/inkstack.exec_server.relay.v1.rs"],
    visibility = ["//inkstack-rs/exec-server/tests/support:__pkg__"],
)

inkstack_rust_crate(
    name = "exec-server",
    crate_name = "inkstack_exec_server",
    crate_srcs = glob([
        "src/**/*.rs",
        "tests/unit/**/*.rs",
    ]),
    deps_extra = [
        "@crates//:opentelemetry",
        "@crates//:opentelemetry_sdk",
        "@crates//:toml",
    ],
    extra_binaries = [
        "//inkstack-rs/bwrap:bwrap",
        "//inkstack-rs/windows-sandbox-rs:inkstack-command-runner",
        "//inkstack-rs/windows-sandbox-rs:inkstack-windows-sandbox-setup",
    ],
    integration_compile_data_extra = [
        "src/proto/inkstack.exec_server.relay.v1.rs",
    ],
    # Keep the crate's tests single-threaded under Bazel because they install
    # process-global test-binary dispatch state, and the remote exec-server
    # cases already rely on serialization around the full CLI path.
    integration_test_args = ["--test-threads=1"],
    test_tags = ["no-sandbox"],
    unit_test_args = ["--test-threads=1"],
)

exec_server_compat_test(
    name = "exec-server-current-version-test",
    comparison_binary = "//inkstack-rs/cli:inkstack",
    current_binary = "//inkstack-rs/cli:inkstack",
)

exec_server_compat_test(
    name = "exec-server-stable-release-test",
    release = "@inkstack_release_0.162.1_linux_x86_64",
)

exec_server_compat_test(
    name = "exec-server-minimum-release-test",
    release = "@inkstack_release_0.145.0_linux_x86_64",
)
