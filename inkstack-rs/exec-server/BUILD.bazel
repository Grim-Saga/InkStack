load("//:defs.bzl", "inkstack_rust_crate")
load("//bazel/rules/testing/compat:exec_server_compat_test.bzl", "exec_server_compat_test")

exports_files(
    ["src/proto/inkstack.exec_server.relay.v1.rs"],
    visibility = ["//inkstack-rs/exec-server/tests/support:__pkg__"],
)

inkstack_rust_crate(
    name = "exec-server",
    crate_name = "inkstack_exec_server",
    crate_srcs = glob([
        "src/**/*.rs",
        "tests/unit/**/*.rs",
    ]),
    deps_extra = [
        "@crates//:opentelemetry",
        "@crates//:opentelemetry_sdk",
        "@crates//:toml",
    ],
    extra_binaries = [
        "//inkstack-rs/bwrap:bwrap",
        "//inkstack-rs/windows-sandbox-rs:inkstack-command-runner",
        "//inkstack-rs/windows-sandbox-rs:inkstack-windows-sandbox-setup",
    ],
    integration_compile_data_extra = [
        "src/proto/inkstack.exec_server.relay.v1.rs",
    ],
    # Keep the crate's tests single-threaded under Bazel because they install
    # process-global test-binary dispatch state, and the remote exec-server
    # cases already rely on serialization around the full CLI path.
    integration_test_args = ["--test-threads=1"],
    test_tags = ["no-sandbox"],
    unit_test_args = ["--test-threads=1"],
)

exec_server_compat_test(
    name = "exec-server-current-version-test",
    comparison_binary = "//inkstack-rs/cli:inkstack",
    current_binary = "//inkstack-rs/cli:inkstack",
)

# Cross-version compatibility coverage is intentionally absent for now.
#
# The current-version test above is a same-binary smoke test: it exercises
# both exec-server protocol directions against the locally built CLI, which
# verifies the relay contract but NOT compatibility with any other release.
# It is not a substitute for cross-version coverage.
#
# The former exec-server-stable-release-test and
# exec-server-minimum-release-test targets compared local builds against
# pinned historical Codex application packages fetched from OpenAI's
# release infrastructure. InkStack no longer depends on those downloads.
#
# To restore cross-version coverage: once InkStack publishes its own
# application releases, add exec_server_compat_test targets with
# `release =` pointing at a pinned, sha256-verified repository of an actual
# previous InkStack release archive (never a fabricated URL or a checksum
# from another project's artifacts). The exec_server_compat_test rule and
# its runner binary under //bazel/rules/testing/compat are kept for that
# purpose.
